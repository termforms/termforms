# --- CMake build trees -------------------------------------------------------
# Out-of-source builds are the norm (cmake -B build); presets may add others.
/build/
/build-*/
/out/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# --- Compiler and linker output ----------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.dSYM/

# --- zig cc caches -------------------------------------------------------------
.zig-cache/
zig-cache/
zig-out/

# --- Generated C from test runs (kept out unless checked in as golden files) --
/tests/**/actual/

# --- Editors and OS clutter ----------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db

# --- tfc output ---------------------------------------------------------------
*.tf.c
*.tf-obj/
# Programs built from the examples (everything but the sources).
/examples/*
!/examples/*.bas
