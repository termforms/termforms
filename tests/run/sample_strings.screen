

     ┌───────────────────────────── Strings ──────────────────────────────┐
     │ ┌────────────────────────────────────────────────────────────────┐ │
     │ │s = "Hello, wörld": Len 12 characters, LenB 13 bytes            │ │
     │ │Left$(s, 5) = Hello, Right$(s, 5) = wörld                       │ │
     │ │Mid$(s, 8, 3) = wör, InStr(s, "w") = 8                          │ │
     │ │Replace: Goodbye, wörld                                         │ │
     │ │UCase$: HELLO, WöRLD (A-Z only for now)                         │ │
     │ │Trim$("  padded  ") = [padded]                                  │ │
     │ │StrReverse: desserts                                            │ │
     │ │CStr(42) = "42", Str$(42) = " 42" (a space for the sign)        │ │
     │ │Val("3.5 apples") = 3.5                                         │ │
     │ │after Mid$(code, 5, 3) = "999": ABC-999                         │ │
     │ │Chr$(65) & Asc("B"): A66                                        │ │
     │ │                                                                │ │
     │ │                                                                │ │
     │ │                                                                │ │
     │ │                                                                │ │
     │ └────────────────────────────────────────────────────────────────┘ │
     │                                                                    │
     └────────────────────────────────────────────────────────────────────┘
