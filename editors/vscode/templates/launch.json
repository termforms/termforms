{
  // Debugging a TermForms program with CodeLLDB (the vadimcn.vscode-lldb
  // extension): copy into your program's .vscode folder, beside tasks.json.
  // Set termforms.home (the TermForms folder) in your settings, so the
  // printers load: Strings as text, arrays and Dictionaries by element.
  // On Windows, in settings.json write it with forward slashes
  // (C:/Users/me/termforms): JSON reads \t in C:\Users\me\termforms as a tab.
  // F9 sets a breakpoint on a .bas line; F5 builds and starts.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TermForms: debug this file",
      "type": "lldb",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "windows": { "program": "${fileDirname}/${fileBasenameNoExtension}.exe" },
      "cwd": "${fileDirname}",
      "preLaunchTask": "tfc: build this file",
      // The program draws its forms: it needs a terminal of its own.
      "terminal": "integrated",
      "initCommands": [
        "command script import \"${config:termforms.home}/debug/lldb/termforms.py\""
      ]
    },
    {
      "name": "TermForms: debug the project",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/myprogram",
      "windows": { "program": "${workspaceFolder}/myprogram.exe" },
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "tfc: build the project",
      "terminal": "integrated",
      "initCommands": [
        "command script import \"${config:termforms.home}/debug/lldb/termforms.py\""
      ]
    }
  ]
}
