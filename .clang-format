# TermForms C and C++ formatting.
# Pinned formatter: clang-format 23.1.3 from PyPI (see toolchain.txt), so the
# Mac, the Linux box and CI all format identically.
---
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# Allman braces: every opening brace on its own line, except the
# extern "C" wrapper in C headers, which stays compact and unindented.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
IndentExternBlock: NoIndent

AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true
IndentCaseLabels: true
PointerAlignment: Right
ReferenceAlignment: Right

AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false

# Project headers before system headers, each group sorted.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '^<doctest'
    Priority: 2
  - Regex: '^<'
    Priority: 3
SortIncludes: CaseSensitive
